{
  "name": "effect-hatchet",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./workflow-engine": {
      "types": "./dist/HatchetWorkflowEngine.d.ts",
      "import": "./dist/HatchetWorkflowEngine.js"
    },
    "./worker": {
      "types": "./dist/HatchetWorker.d.ts",
      "import": "./dist/HatchetWorker.js"
    }
  },
  "description": "PoC: Hatchet as a backend for Effect's WorkflowEngine",
  "scripts": {
    "build": "rm -rf dist && bun build src/HatchetWorkflowEngine.ts src/HatchetWorker.ts --outdir dist --target bun --format esm --packages external && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/HatchetWorkflowEngine.test.ts",
    "test:e2e": "vitest run test/e2e.test.ts",
    "worker": "node example/Worker.ts",
    "main": "node example/Main.ts"
  },
  "dependencies": {
    "@hatchet-dev/typescript-sdk": "^1.33.2",
    "effect": "4.0.0-rc.117"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
